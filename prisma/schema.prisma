generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  work
  education
  project
}

// ─── Portfolio Content Models ────────────────────────────────────────────────

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique @map("slug")
  title        Json     @map("title")        // { en: string; fr?: string }
  description  Json     @map("description")  // { en: string; fr?: string }
  body         Json?    @map("body")          // { en: string; fr?: string }
  techStack    String[] @map("tech_stack")
  clientRegion String?  @map("client_region")
  imageUrl     String?  @map("image_url")
  schematicData Json?   @map("schematic_data")
  published    Boolean  @default(false) @map("published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @map("name")
  category  String   @map("category")
  level     Int      @map("level") // 1–5 proficiency
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model TimelineEntry {
  id           String    @id @default(cuid())
  title        Json      @map("title")       // { en: string; fr?: string }
  description  Json      @map("description") // { en: string; fr?: string }
  organization String    @map("organization")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  type         EntryType @map("type")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("timeline_entries")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @map("name")
  email     String   @map("email")
  message   String   @map("message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// ─── BetterAuth Models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
